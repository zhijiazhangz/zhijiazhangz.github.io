    - 27*y4^3*y5*y7 + (-18-18*a)*y4^3*y5*y8 + (6+12*a)*y4^3*y7^2 + (-6+6*a)*y4^3*y7*y8 + (-9+9*a)*y4^2*y5^2*y6
    + 18*a*y4^2*y5^2*y7 + 18*a*y4^2*y5^2*y8 + (-9-18*a)*y4^2*y5*y6^2 + 18*a*y4^2*y5*y6*y7
    + (9+18*a)*y4^2*y5*y6*y8 + (18+18*a)*y4^2*y5*y7^2 + (30+33*a)*y4^2*y5*y7*y8 + (-3+3*a)*y4^2*y5*y8^2
    - 18*y4^2*y6^2*y7 + (-6+6*a)*y4^2*y6*y7^2 + (6-6*a)*y4^2*y6*y7*y8 - 3*a*y4^2*y7^3 + (12-6*a)*y4^2*y7^2*y8
    + (3+3*a)*y4^2*y7*y8^2 + (9+18*a)*y4*y5^2*y6^2 + (27+27*a)*y4*y5^2*y6*y7 + (9+9*a)*y4*y5^2*y6*y8
    + (12+6*a)*y4*y5^2*y7^2 + 9*y4*y5^2*y7*y8 + (6+3*a)*y4*y5^2*y8^2 + (-9+9*a)*y4*y5*y6^3
    + 27*a*y4*y5*y6^2*y7 + (-9-9*a)*y4*y5*y6^2*y8 + (12+6*a)*y4*y5*y6*y7^2 + (3-12*a)*y4*y5*y6*y7*y8
    + (3-3*a)*y4*y5*y6*y8^2 - 6*a*y4*y5*y7^3 + (-6-18*a)*y4*y5*y7^2*y8 + (3-9*a)*y4*y5*y7*y8^2
    + (12+6*a)*y4*y6^2*y7^2 + (6+12*a)*y4*y6^2*y7*y8 + 6*y4*y6*y7^3 + 6*a*y4*y6*y7^2*y8
    + (-6-6*a)*y4*y6*y7*y8^2 - 6*y4*y7^3*y8 + (-6-6*a)*y4*y7^2*y8^2 + 9*y5^2*y6^2*y7 + (6-6*a)*y5^2*y6*y7^2
    + (-6-12*a)*y5^2*y6*y7*y8 - 3*a*y5^2*y7^3 + (-6-6*a)*y5^2*y7^2*y8 - 3*y5^2*y7*y8^2 + (18+18*a)*y5*y6^3*y7
    + (24+12*a)*y5*y6^2*y7^2 + (-6-12*a)*y5*y6^2*y7*y8 + 6*y5*y6*y7^3 + (-18-12*a)*y5*y6*y7^2*y8
    + 6*a*y5*y6*y7*y8^2 - 6*y5*y7^3*y8 + 6*a*y5*y7^2*y8^2 + 9*a*y6^4*y7 + (6+12*a)*y6^3*y7^2
    + (-6-12*a)*y6^3*y7*y8 + (3+3*a)*y6^2*y7^3 + (-12-18*a)*y6^2*y7^2*y8 + (3+3*a)*y6^2*y7*y8^2
    + (-6-6*a)*y6*y7^3*y8 + (6+6*a)*y6*y7^2*y8^2 + (3+3*a)*y7^3*y8^2)/1;

//Define inverse of pi
inverseForms := [qInv,e1Inv,e2Inv,e3Inv,e4Inv,e5Inv,l12Inv,l13Inv,
    l14Inv,l15Inv,l23Inv,l24Inv,l25Inv,l34Inv,l35Inv,l45Inv];

piinverse:=hom<PP15->PP7|inverseForms>;

//Checking pi(piinverse) is indeed identity, on the level of coordinate ring
composition:=[piinverse(pipolynomial(PP7.x)):x in [1..8]];

gcd:=GCD(composition);

compositionimgae:=[PP7!(x/gcd):x in composition];

compositionimgae;
//This is the image of the composition of two maps, so they are indeed inverse to each other
//Thus, pi is birational
