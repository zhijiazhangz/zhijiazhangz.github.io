////////////////////////////////////////////////////////////////////////
// The codes include a construction of 
// P(Spec(Cox(X))) for the C3 : C4 quartic del Pezzo surface
// and an explicit G-equivariant birational map pi to P^7.
// We check its birationality by presenting an inverse.
// Ground field: Q(z), z^2 + z + 1 = 0.
// 
////////////////////////////////////////////////////////////////////////

K:= CyclotomicField(3);
a:=RootOfUnity(3);
b:=a^2;

P15<q,e1,e2,e3,e4,e5,
    l12,l13,l14,l15,l23,l24,l25,l34,l35,l45> := ProjectiveSpace(K,15);
PP15 := CoordinateRing(P15);
R := [
    e2*l12 - e3*l13 + e4*l14,
    a*e2*l12 - b*e3*l13 + e5*l15,

    e1*l12 - e3*l23 + e4*l24,
    e1*l12 - b*e3*l23 + e5*l25,

    e1*l13 - e2*l23 + e4*l34,
    e1*l13 - a*e2*l23 + e5*l35,

    e1*l14 - e2*l24 + e3*l34,
    (b-1)*e1*l14 + (a-b)*e2*l24 + e5*l45,

    e1*l15 - a*e2*l25 + b*e3*l35,
    (a-1)*e2*l25 + (1-b)*e3*l35 + e4*l45,

    l23*l45 + l24*l35 - l25*l34,
    a*l23*l45 + (a-b)*l24*l35 - e1*q,

    l13*l45 + l14*l35 - l15*l34,
    l13*l45 + (1-b)*l14*l35 - e2*q,

    l12*l45 + l14*l25 - l15*l24,
    l12*l45 + (1-a)*l14*l25 - e3*q,

    l12*l35 - l13*l25 + l15*l23,
    (b-1)*l12*l35 + (1-a)*l13*l25 - e4*q,

    l12*l34 - l13*l24 + l14*l23,
    a*(b-1)*l12*l34 + b*(1-a)*l13*l24 - e5*q
];

CoxRelations := R;
//IY is the ideal of the relations in Cox ring
IY := ideal<PP15 | CoxRelations>;
//Y is the projectivization of Spec(Cox(S))
Y  := Scheme(P15,CoxRelations);



function MonomialMatrix(F, support, coefficient)
    n := #support;
    M := ZeroMatrix(F,n,n);
    for i in [1..n] do
        M[i,support[i]] := coefficient[i];
    end for;
    return M;
end function;

// Matrix of sigma
Msigma := MonomialMatrix(
    K,
    [ 1, 3, 4, 2, 5, 6, 11, 7, 12, 13, 8, 14, 15, 9, 10, 16 ],
    [ K | 1,1,1,1,1,1, a,a,-a,-1,a,-a,-1,a,1,1 ]
);

// Matrix of tau
Mtau := MonomialMatrix(
    K,
    [ 5, 9, 14, 12, 16, 1, 13, 15, 11, 2, 10, 7, 4, 8, 3, 6 ],
    [ K |
      3*(b-1), (b-1)/3, (a-b)/3, (a-1)/3,
      (b-1)/9, (a-1)/9, (b-1)/3, (a-1)/3,
      b-a, 1-a, (b-a)/3, b-1,
      a-1, a-1, 1-a, 3*(a-1)
    ]
);

//The group C3:C4 with action on the Cox generators
Gcox := sub< GL(16,K) |
    GL(16,K)!Transpose(Msigma),
    GL(16,K)!Transpose(Mtau)
>;

Mg:=Msigma;
Mb:=Mtau;

//Check Cox ring relation is G-invariant
for x in CoxRelations do  
     x^Mg in IY and x^Mb in IY;
end for;

//Coordinate of the fixed point 
fixedpt:=[
    K!a + 1,
    K!1/9*(-a - 2),
    K!1/9*(-a - 2),
    K!1/9*(-a - 2),
    K!1/9*(-a - 2),
    K!1/9*(-a - 2),
    K!1/9*(-a - 2),
    K!1/9*(-a + 1),
    K!1/3,
    K!-1/3,
    K!1/9*(2*a + 1),
    K!1/3*(a + 1),
    K!1/3,
    K!1/3*a,
    K!-1/3,
    K!1
];

//Check this is indeed a fixedpt on Spec(Cox)
Y!Eltseq(Vector(fixedpt)*Transpose(Mg)) eq Y!fixedpt;
Y!Eltseq(Vector(fixedpt)*Transpose(Mb)) eq Y!fixedpt;

//Tangent space of the fixed point
TS:=TangentSpace(Y,Y!fixedpt);

//Define projection pi from the tangent space
h1 :=
    e2 - a*e3 + (a-1)*e4
    + l12 - l13 + l14;

h2 :=
    a*e2 - e3 + (1-a)*e5
    + a*l12 - b*l13 + l15;

h3 :=
    e1 - b*e3 + (b-1)*e4
    + l12 - l23 + l24;

h4 :=
    e1 - a*e3 + (a-1)*e5
    + l12 - b*l23 + l25;

h5 :=
    a*e1 - b*e2 + (b-a)*e4
    + l13 - l23 + l34;

h6 :=
    a*e1 - e2 + (1-a)*e5
    + l13 - a*l23 + l35;

h7 :=
    3*e1 - 3*a*e2 + 3*(a-1)*e5
    + (b-1)*l14 + (a-b)*l24 + l45;

h8 :=
    q + 3*(b-1)*e4
    + 3*l12 - 3*a*l13
    + (b-a)*l25 + (1-b)*l35;

NewBasis := [h1,h2,h3,h4,h5,h6,h7,h8];
pibaselocus:=Scheme(P15,NewBasis);
piideal:=ideal<PP15|NewBasis>;

//check NewBasis indeed defines tangent space of the fixed point
TS eq pibaselocus;

P7<y1,y2,y3,y4,y5,y6,y7,y8>:=ProjectiveSpace(K,7);
PP7:=CoordinateRing(P7);

//Define projection map pi
pi := map<P15 -> P7 | NewBasis>;

//Define projection map on coordinate ring
pipolynomial:=hom<PP7->PP15|NewBasis>;

//Check G-equivariance of pi.
//This is just sanity check. It is equivariant by construction.
for x in NewBasis do  
     x^Mg in piideal and x^Mb in piideal;
end for;

//Constructing inverse of pi, its defining equations are from line 183 -- line 1338

qInv := PP7!((-9-9*a)*y1^4*y8 + (9+18*a)*y1^3*y2*y3 + (18+9*a)*y1^3*y2*y4 + (-18-36*a)*y1^3*y2*y5
    + (18-18*a)*y1^3*y2*y6 - 18*y1^3*y2*y8 + (-9+9*a)*y1^3*y3*y4 + (-18-9*a)*y1^3*y3*y6 + (9+18*a)*y1^3*y4^2
    + (18-18*a)*y1^3*y4*y5 + (27+27*a)*y1^3*y4*y6 + 9*a*y1^3*y4*y8 + (36+18*a)*y1^3*y5*y6
    + (-18-18*a)*y1^3*y5*y8 + (18+36*a)*y1^3*y6^2 + (-27-27*a)*y1^3*y6*y8 + (-12-6*a)*y1^3*y7*y8
    + (12+6*a)*y1^3*y8^2 + (18+9*a)*y1^2*y2^2*y3 + (9-9*a)*y1^2*y2^2*y4 + (-36-18*a)*y1^2*y2^2*y5
    + (-18-36*a)*y1^2*y2^2*y6 + 9*a*y1^2*y2^2*y8 + (9+18*a)*y1^2*y2*y3^2 + (54+27*a)*y1^2*y2*y3*y4
    + (18+36*a)*y1^2*y2*y3*y5 + (-9+63*a)*y1^2*y2*y3*y6 + 9*a*y1^2*y2*y3*y7 + (-27-27*a)*y1^2*y2*y3*y8
    + (18-18*a)*y1^2*y2*y4^2 + (45+36*a)*y1^2*y2*y4*y6 + (9+9*a)*y1^2*y2*y4*y7 + (-9+18*a)*y1^2*y2*y4*y8
    + (-18-36*a)*y1^2*y2*y5^2 + (18-45*a)*y1^2*y2*y5*y6 + (-27-18*a)*y1^2*y2*y5*y7 + (18+36*a)*y1^2*y2*y5*y8
    + 27*y1^2*y2*y6^2 + (-9-27*a)*y1^2*y2*y6*y7 + (-18+36*a)*y1^2*y2*y6*y8 + (6+12*a)*y1^2*y2*y7*y8
    + (12-12*a)*y1^2*y2*y8^2 + (-9+9*a)*y1^2*y3^2*y4 + (-18-9*a)*y1^2*y3^2*y6 + (18+18*a)*y1^2*y3^2*y8
    + (36+45*a)*y1^2*y3*y4^2 + (-18+18*a)*y1^2*y3*y4*y5 + (-63+36*a)*y1^2*y3*y4*y6 - 9*y1^2*y3*y4*y7
    + (18-36*a)*y1^2*y3*y4*y8 + (-36-18*a)*y1^2*y3*y5*y6 + (-18-18*a)*y1^2*y3*y5*y8 + (-54-54*a)*y1^2*y3*y6^2
    + (-9-9*a)*y1^2*y3*y6*y7 + (36+27*a)*y1^2*y3*y6*y8 + (-6+6*a)*y1^2*y3*y7*y8 + (-12-6*a)*y1^2*y3*y8^2
    + 27*y1^2*y4^3 + (-18+18*a)*y1^2*y4^2*y5 + (9+45*a)*y1^2*y4^2*y6 + 9*a*y1^2*y4^2*y7
    + (-27-36*a)*y1^2*y4^2*y8 + (18-18*a)*y1^2*y4*y5^2 + (-9-18*a)*y1^2*y4*y5*y6 + (-9-27*a)*y1^2*y4*y5*y7
    + 36*a*y1^2*y4*y5*y8 + (-27-27*a)*y1^2*y4*y6^2 + (9-9*a)*y1^2*y4*y6*y7 + (27+27*a)*y1^2*y4*y6*y8
    + (18+27*a)*y1^2*y4*y7*y8 - 9*y1^2*y4*y8^2 + (36+18*a)*y1^2*y5^2*y6 + (-9-9*a)*y1^2*y5^2*y8
    + (27+27*a)*y1^2*y5*y6^2 + (18-9*a)*y1^2*y5*y6*y7 + (-54-18*a)*y1^2*y5*y6*y8 + (-6+6*a)*y1^2*y5*y7*y8
    + (24+12*a)*y1^2*y5*y8^2 + (18+9*a)*y1^2*y6^3 + (27+18*a)*y1^2*y6^2*y7 + (-45-18*a)*y1^2*y6^2*y8
    + (-33-3*a)*y1^2*y6*y7*y8 + (24+3*a)*y1^2*y6*y8^2 - 3*y1^2*y7^2*y8 + (12-6*a)*y1^2*y7*y8^2 - 3*y1^2*y8^3
    + (9+18*a)*y1*y2^2*y3^2 + 27*y1*y2^2*y3*y4 + (-18-36*a)*y1*y2^2*y3*y5 + 54*y1*y2^2*y3*y6 - 9*y1*y2^2*y3*y7
    - 27*y1*y2^2*y3*y8 + (-9-18*a)*y1*y2^2*y4^2 + (-18+18*a)*y1*y2^2*y4*y5 + (-18-36*a)*y1*y2^2*y4*y6
    + 9*a*y1*y2^2*y4*y7 + (9+27*a)*y1*y2^2*y4*y8 + (9+45*a)*y1*y2^2*y5*y6 + (18+27*a)*y1*y2^2*y5*y7
    + 36*y1*y2^2*y5*y8 + (-36+9*a)*y1*y2^2*y6^2 + (-9+18*a)*y1*y2^2*y6*y7 + (36+27*a)*y1*y2^2*y6*y8
    + (6-6*a)*y1*y2^2*y7*y8 + (-6-12*a)*y1*y2^2*y8^2 + (-9-18*a)*y1*y2*y3^3 + (-36+9*a)*y1*y2*y3^2*y4
    + (36+72*a)*y1*y2*y3^2*y5 + (-27-27*a)*y1*y2*y3^2*y6 + (18+9*a)*y1*y2*y3^2*y7 + 18*y1*y2*y3^2*y8
    + (36+45*a)*y1*y2*y3*y4^2 + (90-36*a)*y1*y2*y3*y4*y5 + (72+36*a)*y1*y2*y3*y4*y6 - 27*a*y1*y2*y3*y4*y7
    + (-36-27*a)*y1*y2*y3*y4*y8 + (-9-18*a)*y1*y2*y3*y5^2 + (72+90*a)*y1*y2*y3*y5*y6 - 18*y1*y2*y3*y5*y7
    + (-72-54*a)*y1*y2*y3*y5*y8 + (-18+72*a)*y1*y2*y3*y6^2 + (9+9*a)*y1*y2*y3*y6*y7
    + (-27-63*a)*y1*y2*y3*y6*y8 + (-3+3*a)*y1*y2*y3*y7^2 + (-12+3*a)*y1*y2*y3*y7*y8 + (6+12*a)*y1*y2*y3*y8^2
    + (9-9*a)*y1*y2*y4^3 + (-54-54*a)*y1*y2*y4^2*y5 + (18-45*a)*y1*y2*y4^2*y6 + (-18-9*a)*y1*y2*y4^2*y7
    + (-9+9*a)*y1*y2*y4^2*y8 + (-9+9*a)*y1*y2*y4*y5^2 + (9+18*a)*y1*y2*y4*y5*y6 + (9+63*a)*y1*y2*y4*y5*y7
    + (-18+18*a)*y1*y2*y4*y5*y8 + (9+18*a)*y1*y2*y4*y6^2 + (-27+9*a)*y1*y2*y4*y6*y7
    + (-27-18*a)*y1*y2*y4*y6*y8 + (3+6*a)*y1*y2*y4*y7^2 + (15+12*a)*y1*y2*y4*y7*y8 + (-36+9*a)*y1*y2*y5^2*y6
    + (-9+18*a)*y1*y2*y5^2*y7 + (36+36*a)*y1*y2*y5^2*y8 + (-126-90*a)*y1*y2*y5*y6^2
    + (-81-18*a)*y1*y2*y5*y6*y7 + (45+72*a)*y1*y2*y5*y6*y8 + (-3+3*a)*y1*y2*y5*y7^2 + (57+15*a)*y1*y2*y5*y7*y8
    - 18*a*y1*y2*y5*y8^2 + (-27-81*a)*y1*y2*y6^3 + (-45-54*a)*y1*y2*y6^2*y7 + (36+81*a)*y1*y2*y6^2*y8
    + (-6-3*a)*y1*y2*y6*y7^2 + (57+60*a)*y1*y2*y6*y7*y8 + (-6-30*a)*y1*y2*y6*y8^2 + 6*y1*y2*y7^2*y8
    + (-12-18*a)*y1*y2*y7*y8^2 + 6*a*y1*y2*y8^3 + (9-9*a)*y1*y3^3*y4 + (18+9*a)*y1*y3^3*y6
    + (-27-27*a)*y1*y3^2*y4^2 + (-36+36*a)*y1*y3^2*y4*y5 + (9-36*a)*y1*y3^2*y4*y6 + (9+18*a)*y1*y3^2*y4*y7
    - 9*a*y1*y3^2*y4*y8 + (-72-36*a)*y1*y3^2*y5*y6 + (18+18*a)*y1*y3^2*y5*y8 + (18+9*a)*y1*y3^2*y6^2
    + (-9+9*a)*y1*y3^2*y6*y7 + (27+27*a)*y1*y3^2*y6*y8 + (12+6*a)*y1*y3^2*y7*y8 + (-12-6*a)*y1*y3^2*y8^2
    + (-9+9*a)*y1*y3*y4^3 + (90+72*a)*y1*y3*y4^2*y5 + (45+9*a)*y1*y3*y4^2*y6 + (27+9*a)*y1*y3*y4^2*y7
    + (-27-9*a)*y1*y3*y4^2*y8 + (9-9*a)*y1*y3*y4*y5^2 + (-18+126*a)*y1*y3*y4*y5*y6 + (-18-18*a)*y1*y3*y4*y5*y7
    + (18-54*a)*y1*y3*y4*y5*y8 + (9+45*a)*y1*y3*y4*y6^2 + (9+36*a)*y1*y3*y4*y6*y7 + (9-72*a)*y1*y3*y4*y6*y8
    + (-6-3*a)*y1*y3*y4*y7^2 - 27*a*y1*y3*y4*y7*y8 + (6+30*a)*y1*y3*y4*y8^2 + (18+9*a)*y1*y3*y5^2*y6
    + (-18-18*a)*y1*y3*y5^2*y8 + (-72-36*a)*y1*y3*y5*y6^2 - 18*a*y1*y3*y5*y6*y7 + 36*y1*y3*y5*y6*y8
    - 18*y1*y3*y5*y7*y8 + (-18-36*a)*y1*y3*y6^3 + (-18-9*a)*y1*y3*y6^2*y7 + (54+54*a)*y1*y3*y6^2*y8
    + (-3-6*a)*y1*y3*y6*y7^2 + (12+15*a)*y1*y3*y6*y7*y8 + (-36-18*a)*y1*y3*y6*y8^2 + 6*a*y1*y3*y7^2*y8
    + (-6-6*a)*y1*y3*y7*y8^2 + 6*y1*y3*y8^3 + (18-18*a)*y1*y4^3*y5 + (18-18*a)*y1*y4^3*y6 - 9*a*y1*y4^3*y7
    + 18*a*y1*y4^3*y8 + (-18-9*a)*y1*y4^2*y5^2 + (54+81*a)*y1*y4^2*y5*y6 + (-27+18*a)*y1*y4^2*y5*y7
    + (-36-36*a)*y1*y4^2*y5*y8 + (18+36*a)*y1*y4^2*y6^2 + (-9+9*a)*y1*y4^2*y6*y7 + (-54-54*a)*y1*y4^2*y6*y8
    + (-3+3*a)*y1*y4^2*y7^2 + (-12-15*a)*y1*y4^2*y7*y8 + (24+12*a)*y1*y4^2*y8^2 + (-54-54*a)*y1*y4*y5^2*y6
    + (-27-9*a)*y1*y4*y5^2*y7 + 27*a*y1*y4*y5^2*y8 + (-72-63*a)*y1*y4*y5*y6^2 + (-90-81*a)*y1*y4*y5*y6*y7
    + (45+27*a)*y1*y4*y5*y6*y8 + (-6-3*a)*y1*y4*y5*y7^2 + (45+45*a)*y1*y4*y5*y7*y8 + (-12-6*a)*y1*y4*y5*y8^2
    + (-18-36*a)*y1*y4*y6^3 + (-27-45*a)*y1*y4*y6^2*y7 + (54+36*a)*y1*y4*y6^2*y8 + (-9-9*a)*y1*y4*y6*y7^2
    + (51+48*a)*y1*y4*y6*y7*y8 + (-24+6*a)*y1*y4*y6*y8^2 + (12+9*a)*y1*y4*y7^2*y8 + (-18-6*a)*y1*y4*y7*y8^2
    - 6*a*y1*y4*y8^3 + (-9-45*a)*y1*y5^2*y6^2 + (-18-27*a)*y1*y5^2*y6*y7 + (-27+9*a)*y1*y5^2*y6*y8
    + (6+12*a)*y1*y5^2*y7*y8 + (12+6*a)*y1*y5^2*y8^2 + (54-27*a)*y1*y5*y6^3 + (9-45*a)*y1*y5*y6^2*y7
    + (-45+36*a)*y1*y5*y6^2*y8 + (-3-6*a)*y1*y5*y6*y7^2 + (-3+57*a)*y1*y5*y6*y7*y8 + (24-6*a)*y1*y5*y6*y8^2
    + (6+6*a)*y1*y5*y7^2*y8 + (6-12*a)*y1*y5*y7*y8^2 - 6*y1*y5*y8^3 + (36+18*a)*y1*y6^4 + 27*y1*y6^3*y7
    - 54*y1*y6^3*y8 + (3-3*a)*y1*y6^2*y7^2 + (-39+21*a)*y1*y6^2*y7*y8 + (18-18*a)*y1*y6^2*y8^2
    + (-3+9*a)*y1*y6*y7^2*y8 + (12-24*a)*y1*y6*y7*y8^2 + 6*a*y1*y6*y8^3 - 6*a*y1*y7^2*y8^2 + 6*a*y1*y7*y8^3
    + (-9+9*a)*y2^2*y3^3 + (45+36*a)*y2^2*y3^2*y4 + (18-18*a)*y2^2*y3^2*y5 + (-9+9*a)*y2^2*y3^2*y6
    + (-18-18*a)*y2^2*y3^2*y7 + (-18-18*a)*y2^2*y3^2*y8 + (9-36*a)*y2^2*y3*y4^2 + (-72-36*a)*y2^2*y3*y4*y5
    + (-9+9*a)*y2^2*y3*y4*y6 + (-18+18*a)*y2^2*y3*y4*y7 + (-9+27*a)*y2^2*y3*y4*y8 + (9+18*a)*y2^2*y3*y5*y6
    + (9+9*a)*y2^2*y3*y5*y7 + (18+18*a)*y2^2*y3*y5*y8 + (-18-36*a)*y2^2*y3*y6^2 + (-9-18*a)*y2^2*y3*y6*y7
    + 18*a*y2^2*y3*y6*y8 + (3-3*a)*y2^2*y3*y7^2 + 9*y2^2*y3*y7*y8 + (6-6*a)*y2^2*y3*y8^2 + (-18-9*a)*y2^2*y4^3
    + (18+36*a)*y2^2*y4^2*y5 + (27+27*a)*y2^2*y4^2*y6 + (18+18*a)*y2^2*y4^2*y7 + (18+9*a)*y2^2*y4^2*y8
